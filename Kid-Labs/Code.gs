function getActiveEmissionFactorsMap(ss) {
  var map = {};
  for (var i = 0; i < KIDS_DEFAULT_EMISSION_FACTORS.length; i++) {
    var row = KIDS_DEFAULT_EMISSION_FACTORS[i];
    map[row[0]] = Number(row[3]) || 0;
  }
  if (!ss) return map;
  var efSheet = ss.getSheetByName("Emission_Factors");
  if (!efSheet || efSheet.getLastRow() <= 1) return map;
  var data = efSheet.getDataRange().getValues();
  var headers = data[0];
  var idxId = headers.indexOf("Emission_Factor_ID");
  if (idxId === -1) idxId = headers.indexOf("Factor_ID");
  var idxVal = headers.indexOf("Factor_Value");
  if (idxVal === -1) idxVal = headers.indexOf("Emission_Factor_Value");
  var idxStatus = headers.indexOf("Active_Status");
  if (idxStatus === -1) idxStatus = headers.indexOf("Status");
  if (idxId === -1 || idxVal === -1) return map;
  for (var r = 1; r < data.length; r++) {
    var fId = String(data[r][idxId] || "").trim();
    var status = idxStatus !== -1 ? String(data[r][idxStatus] || "Active").trim() : "Active";
    if (fId && status.toLowerCase() !== "inactive") {
      map[fId] = Number(data[r][idxVal]) || 0;
    }
  }
  return map;
}

function computeAuthoritativeKidsScores(ss, ageGroup, questionOrderStr, answersMap) {
  var order = String(questionOrderStr || "")
    .split(",")
    .map(function(s) { return s.trim(); })
    .filter(Boolean);

  var dims = {
    "Sustainable Habits": 0,
    "Decision-making": 0,
    "Environmental Awareness": 0,
    "Practical Application": 0
  };

  var topics = {
    "Nature & Biodiversity": { earned: 0, max: 0 },
    "Water Conservation": { earned: 0, max: 0 },
    "Energy Conservation": { earned: 0, max: 0 },
    "Waste & Recycling": { earned: 0, max: 0 },
    "Food Sustainability": { earned: 0, max: 0 },
    "Green Transport": { earned: 0, max: 0 },
    "Climate Awareness": { earned: 0, max: 0 }
  };

  var optimalCount = 0;
  var records = [];

  for (var i = 0; i < order.length; i++) {
    var qId = order[i];
    var spec = KIDS_AUTHORITATIVE_SCORING[qId];
    if (!spec) continue;
    var opt = String((answersMap && answersMap[qId]) || "").toUpperCase();
    var pts = (opt && spec[opt] !== undefined) ? Number(spec[opt]) : 0;
    if (pts === 10) optimalCount++;

    if (dims[spec.dim] !== undefined) {
      dims[spec.dim] += pts;
    }
    if (!topics[spec.topic]) {
      topics[spec.topic] = { earned: 0, max: 0 };
    }
    topics[spec.topic].earned += pts;
    topics[spec.topic].max += 10;

    records.push({
      Question_ID: qId,
      Category: spec.dim,
      Topic_Category: spec.topic,
      Selected_Option: opt,
      Awarded_Points: pts,
      Maximum_Points: 10
    });
  }

  var overall = Math.min(
    100,
    dims["Sustainable Habits"] +
      dims["Decision-making"] +
      dims["Environmental Awareness"] +
      dims["Practical Application"]
  );
  var pct = Math.round((overall / 100) * 100);

  var strongest = "Nature & Biodiversity";
  var weakest = "Energy Conservation";
  var bestPct = -1;
  var worstPct = 101;
  for (var t in topics) {
    if (topics[t].max > 0) {
      var tPct = Math.round((topics[t].earned / topics[t].max) * 100);
      if (tPct > bestPct) { bestPct = tPct; strongest = t; }
      if (tPct < worstPct) { worstPct = tPct; weakest = t; }
    }
  }

  var stage = "Seedling Explorer";
  if (pct >= 85) stage = ageGroup === "11-14" ? "Climate Changemaker Leader" : "Planet Hero";
  else if (pct >= 70) stage = ageGroup === "11-14" ? "Eco Innovator" : "Green Guardian";
  else if (pct >= 50) stage = ageGroup === "11-14" ? "Sustainability Pathfinder" : "Nature Sprout";

  return {
    Sustainable_Habit_Score: dims["Sustainable Habits"],
    Decision_Making_Score: dims["Decision-making"],
    Environmental_Awareness_Score: dims["Environmental Awareness"],
    Practical_Application_Score: dims["Practical Application"],
    Overall_Green_Score: overall,
    Quiz_Score_Percentage: pct,
    Optimal_Answers_Count: optimalCount,
    Strongest_Category: strongest,
    Improvement_Area: weakest,
    Learning_Stage: stage,
    Topics: topics,
    Dimensions: dims,
    Records: records
  };
}

function computeAuthoritativeKidsCarbon(ss, missions) {
  var ef = getActiveEmissionFactorsMap(ss);
  var m1 = (missions && (missions.FP01 || missions.FP01_School_Commute)) || {};
  var m2 = (missions && (missions.FP02 || missions.FP02_Daily_Travel)) || {};
  var m3 = (missions && (missions.FP03 || missions.FP03_Household_Electricity)) || {};
  var m4 = (missions && (missions.FP04 || missions.FP04_Supplies_Devices)) || {};
  var m5 = (missions && (missions.FP05 || missions.FP05_Food_Waste)) || {};
  var weeksPerMonth = 4.33;

  var fuelMultipliers = { petrol: 1.0, diesel: 1.14, cng: 0.76, hybrid: 0.68, ev: 0.32, na: 1.0 };
  function computeModeKmFactor(mode, fuel, occupancy) {
    var occ = Math.max(1, Number(occupancy) || 1);
    var fMult = fuelMultipliers[fuel] || 1.0;
    if (mode === "walk" || mode === "cycle") return 0;
    if (mode === "school_bus" || mode === "public_bus") return ef.EF_TR_SCHOOL_BUS || 0.027;
    if (mode === "metro_train") return ef.EF_TR_METRO_TRAIN || 0.032;
    if (mode === "auto") return ((ef.EF_TR_AUTO || 0.105) * fMult) / occ;
    if (mode === "two_wheeler") return ((ef.EF_TR_TWO_WHEELER || 0.068) * fMult) / occ;
    return ((ef.EF_TR_CAR_PETROL || 0.168) * fMult) / occ;
  }

  // 1. School Commute
  var m1Mode = m1.mode || "school_bus";
  var m1Fuel = m1.fuel || (m1Mode === "walk" || m1Mode === "cycle" ? "na" : "petrol");
  var m1Dist = Math.max(0, Number(m1.oneWayKm) || 0);
  var m1Days = Math.min(7, Math.max(0, Number(m1.schoolDaysPerWeek) || 5));
  var m1ReturnMult = m1.returnTrip === "one_way" ? 1 : 2;
  var m1Occ = Math.max(1, Number(m1.occupancy) || (m1Mode === "car" ? 2 : 1));
  var m1MonthlyKm = m1Dist * m1ReturnMult * m1Days * weeksPerMonth;
  var schoolCommuteKg = m1MonthlyKm * computeModeKmFactor(m1Mode, m1Fuel, m1Occ);
  if (m1.hasSecondLeg && Number(m1.leg2Km) > 0) {
    var leg2Mode = m1.leg2Mode || "walk";
    var leg2Dist = Math.max(0, Number(m1.leg2Km) || 0);
    var leg2Occ = Math.max(1, Number(m1.leg2Occupancy) || 2);
    schoolCommuteKg += (leg2Dist * m1ReturnMult * m1Days * weeksPerMonth) * computeModeKmFactor(leg2Mode, "petrol", leg2Occ);
  }
  schoolCommuteKg = Number(schoolCommuteKg.toFixed(2));

  // 2. Daily Travel Beyond School
  var m2TypesList = (Array.isArray(m2.journeyTypes) && m2.journeyTypes.length > 0)
    ? m2.journeyTypes
    : (m2.journeyType ? String(m2.journeyType).split(",").map(function(s) { return s.trim(); }).filter(Boolean) : ["sports_tuition"]);
  var m2Type = m2TypesList.indexOf("none") !== -1 ? "none" : m2TypesList.join(", ");
  var dailyTravelKg = 0;
  if (m2Type !== "none") {
    var m2ModesList = (Array.isArray(m2.modes) && m2.modes.length > 0)
      ? m2.modes
      : (m2.mode ? String(m2.mode).split(",").map(function(s) { return s.trim(); }).filter(Boolean) : ["cycle"]);
    var m2Fuel = m2.fuel || "petrol";
    var m2Dist = Math.max(0, Number(m2.distanceKm) || 0);
    var m2Trips = Math.max(0, Number(m2.tripsPerWeek) || 0);
    var m2Occ = Math.max(1, Number(m2.occupancy) || 2);
    var totalModeFactor = 0;
    for (var mi = 0; mi < m2ModesList.length; mi++) {
      totalModeFactor += computeModeKmFactor(m2ModesList[mi], m2Fuel, m2Occ);
    }
    var avgModeFactor = m2ModesList.length > 0 ? (totalModeFactor / m2ModesList.length) : 0;
    dailyTravelKg = Number(((m2Dist * m2Trips * weeksPerMonth) * avgModeFactor).toFixed(2));
  }

  // 3. Household Electricity (Transparent per-capita allocation)
  var billStatus = m3.billAvailable || "estimate";
  var householdSize = Math.max(1, Number(m3.householdSize) || 4);
  var gridFactor = ef.EF_ELEC_CEA_IN || 0.727;
  var allocatedElecKg = 0;
  var allocatedKwh = 0;
  var isElecIncomplete = (billStatus === "unavailable" || m3.monthlyKwh === "" || m3.monthlyKwh === null || m3.monthlyKwh === undefined);
  if (!isElecIncomplete) {
    var totalHouseholdKwh = Math.max(0, Number(m3.monthlyKwh) || 0);
    allocatedKwh = Number((totalHouseholdKwh / householdSize).toFixed(1));
    allocatedElecKg = Number((allocatedKwh * gridFactor).toFixed(2));
  }

  // 4. Supplies & Digital Devices
  var notebooksYr = Math.max(0, Number(m4.notebooksPerYear) || 8);
  var stationerySetsYr = Math.max(0, Number(m4.stationerySetsPerYear) || 2);
  var uniformsYr = Math.max(0, Number(m4.uniformSetsPerYear) || 2);
  var monthlySuppliesKg = (
    notebooksYr * (ef.EF_SUP_NOTEBOOK || 0.85) +
    stationerySetsYr * (ef.EF_SUP_STATIONERY || 1.6) +
    uniformsYr * (ef.EF_SUP_UNIFORM || 9.5)
  ) / 12;

  var primaryDevice = m4.primaryDevice || "tablet";
  var deviceOwnership = m4.deviceOwnership || "shared";
  var deviceAge = m4.deviceAge || "1_3_yrs";
  var dailyHours = Math.max(0, Number(m4.dailyHours) || 1.5);
  var deviceTypeScaler = { none: 0, smartphone: 0.45, tablet: 0.65, laptop: 1.0, desktop: 1.25 };
  var ageRetentionScaler = { under_1_yr: 1.15, "1_3_yrs": 1.0, "3_5_yrs": 0.75, over_5_yrs: 0.55 };
  var shareUsers = deviceOwnership === "personal" ? 1 : Math.max(2, Math.round(householdSize / 2));
  var monthlyDeviceEmbodiedKg = (
    ((ef.EF_DEV_EMBODIED || 48.0) *
      (deviceTypeScaler[primaryDevice] !== undefined ? deviceTypeScaler[primaryDevice] : 0.65) *
      (ageRetentionScaler[deviceAge] !== undefined ? ageRetentionScaler[deviceAge] : 1.0)) /
    shareUsers
  ) / 12;
  var deviceWattageKw = primaryDevice === "desktop" ? 0.12 : primaryDevice === "laptop" ? 0.045 : primaryDevice === "tablet" ? 0.012 : primaryDevice === "smartphone" ? 0.006 : 0;
  var standaloneDeviceElecKg = isElecIncomplete ? (dailyHours * 30 * deviceWattageKw * gridFactor) : 0;
  var suppliesAndDevicesKg = Number((monthlySuppliesKg + monthlyDeviceEmbodiedKg + standaloneDeviceElecKg).toFixed(2));

  // 5. Food & Food Waste
  var dietPattern = m5.dietCategory || "vegetarian";
  var dairyServings = Math.max(0, m5.dairyServingsPerDay !== undefined ? Number(m5.dairyServingsPerDay) : 2);
  var portionSize = m5.portionSize || "medium";
  var wasteFreq = m5.wasteFrequency || "rarely";
  var wasteGramsWeek = Math.max(0, m5.wasteGramsPerWeek !== undefined ? Number(m5.wasteGramsPerWeek) : (wasteFreq === "never" ? 0 : wasteFreq === "rarely" ? 150 : wasteFreq === "sometimes" ? 400 : 800));
  var wasteDisposal = m5.wasteDisposal || "compost";
  var dietMultipliers = { plant_rich: 0.82, vegetarian: 1.0, eggetarian: 1.12, mixed_nonveg: 1.45 };
  var portionMultipliers = { small: 0.82, medium: 1.0, large: 1.2 };
  var monthlyDietKg = (ef.EF_FOOD_DIET_BASE || 1.05) * 30 * (dietMultipliers[dietPattern] || 1.0) * (portionMultipliers[portionSize] || 1.0) + (dairyServings * 0.08 * 30);
  var monthlyWasteKgWeight = (wasteGramsWeek / 1000) * weeksPerMonth;
  var disposalModifier = wasteDisposal === "compost" ? 0.15 : wasteDisposal === "animal_feed" ? 0.1 : wasteDisposal === "segregated" ? 0.45 : 1.0;
  var monthlyFoodWasteEmissions = monthlyWasteKgWeight * (ef.EF_FOOD_WASTE_LANDFILL || 1.9) * disposalModifier;
  var totalFoodKg = Number((monthlyDietKg + monthlyFoodWasteEmissions).toFixed(2));

  var totalMonthly = Number((schoolCommuteKg + dailyTravelKg + allocatedElecKg + suppliesAndDevicesKg + totalFoodKg).toFixed(2));
  var totalAnnual = Number((totalMonthly * 12).toFixed(1));

  return {
    School_Commute_CO2e_kg: schoolCommuteKg,
    Daily_Travel_CO2e_kg: dailyTravelKg,
    Allocated_Electricity_CO2e_kg: allocatedElecKg,
    Allocated_Child_kWh: allocatedKwh,
    Supplies_Devices_CO2e_kg: suppliesAndDevicesKg,
    Food_Waste_CO2e_kg: totalFoodKg,
    Total_Monthly_CO2e_kg: totalMonthly,
    Total_Annual_CO2e_kg: totalAnnual,
    Calculation_Status: isElecIncomplete ? "Partial Estimate (Some Activity Data Unavailable)" : "Complete Indicative Estimate"
  };
}

function handleKidsPartialSave(ss, logs, responseId, payload) {
  var sheets = ensureKidsSheets(ss);
  var profile = payload.Student_Profile || {};
  var participantLabel = [
    profile.childName,
    profile.studentClass ? "Class: " + profile.studentClass : "",
    profile.rollNumber ? "Roll: " + profile.rollNumber : ""
  ].filter(Boolean).join(" | ") || "Anonymous Explorer";

  var respRow = findRowByResponseId(sheets.respondent, responseId);
  if (respRow === -1) {
    var partialResp = new Array(KIDS_RESPONDENT_HEADERS.length).fill("");
    partialResp[0]  = responseId;
    partialResp[1]  = payload.Timestamp || new Date().toISOString();
    partialResp[2]  = participantLabel;
    partialResp[4]  = profile.studentClass || "";
    partialResp[5]  = profile.rollNumber || "";
    partialResp[6]  = "School Student";
    partialResp[7]  = payload.Age_Group || "8-10";
    partialResp[8]  = payload.Quiz_Mode || "Explorer Mode";
    partialResp[9]  = payload.Timestamp || new Date().toISOString();
    partialResp[11] = "In Progress";
    partialResp[12] = 10;
    partialResp[21] = false;
    partialResp[27] = profile.childName || "";
    partialResp[28] = profile.studentClass || "";
    partialResp[29] = profile.rollNumber || "";
    partialResp[30] = Boolean(profile.guardianAssisted);
    partialResp[31] = payload.Selected_Question_IDs || "";
    partialResp[32] = payload.Question_Order || "";
    partialResp[40] = payload.Device_Type || "";
    sheets.respondent.appendRow(partialResp);
  } else {
    sheets.respondent.getRange(respRow, 3).setValue(participantLabel);
    sheets.respondent.getRange(respRow, 28, 1, 6).setValues([[
      profile.childName || "",
      profile.studentClass || "",
      profile.rollNumber || "",
      Boolean(profile.guardianAssisted),
      payload.Selected_Question_IDs || "",
      payload.Question_Order || ""
    ]]);
  }

  // Upsert partial answers into Kids_Quiz_Responses
  var answers = payload.Quiz_Answers || {};
  var quizRowData = [responseId];
  for (var i = 0; i < KIDS_ALL_QUESTION_IDS.length; i++) {
    var qId = KIDS_ALL_QUESTION_IDS[i];
    quizRowData.push(answers[qId] || "");
  }
  quizRowData.push(
    payload.Age_Group || "8-10",
    payload.Quiz_Mode || "Explorer Mode",
    payload.Selected_Question_IDs || "",
    payload.Question_Order || "",
    ""
  );

  var qRow = findRowByResponseId(sheets.quiz, responseId);
  if (qRow === -1) {
    sheets.quiz.appendRow(quizRowData);
  } else {
    sheets.quiz.getRange(qRow, 1, 1, quizRowData.length).setValues([quizRowData]);
  }

  if (logs) {
    logs.appendRow([new Date(), "KIDS PARTIAL SAVE", (payload.Step_Label || "Step") + " saved for " + responseId]);
  }
}

function handleKidsFinalSave(ss, logs, responseId, payload) {
  var sheets = ensureKidsSheets(ss);
  var r = payload.Respondent_Master || {};
  var q = payload.Quiz_Responses || {};
  var fm = payload.Footprint_Missions || {};
  var c = payload.Carbon_Breakdown || {};
  var rec = payload.Recommendations || {};

  var ageGroup = r.Age_Group || q.Age_Group || "8-10";
  var quizMode = r.Quiz_Mode || q.Quiz_Mode || (ageGroup === "11-14" ? "Changemaker Mode" : "Explorer Mode");
  var selectedIdsStr = r.Selected_Question_IDs || q.Selected_Question_IDs || "";
  var questionOrderStr = r.Question_Order || q.Question_Order || selectedIdsStr;
  var answersMap = q.Answers_Map || {};

  // 1. Authoritative Backend Score & Carbon Calculation
  var authScores = computeAuthoritativeKidsScores(ss, ageGroup, questionOrderStr, answersMap);
  var authCarbon = computeAuthoritativeKidsCarbon(ss, fm);

  // 2. Upsert Kids_Respondent_Master
  var respondentRow = [
    responseId,
    new Date(),
    r.Participant_ID || r.Child_Name || "Anonymous Explorer",
    "", // Email left blank for child privacy
    r.Student_Class || "",
    r.Roll_Number || "",
    "School Student",
    ageGroup,
    quizMode,
    r.Start_Date || new Date().toISOString(),
    r.Completion_Date || new Date().toISOString(),
    "Completed",
    10,
    authScores.Optimal_Answers_Count,
    authScores.Quiz_Score_Percentage,
    authScores.Overall_Green_Score,
    authScores.Environmental_Awareness_Score,
    JSON.stringify(authScores.Topics),
    JSON.stringify(authScores.Dimensions),
    authScores.Quiz_Score_Percentage,
    authScores.Learning_Stage,
    true,
    r.Badge || "Planet Protector",
    r.Quiz_Version || "1.1",
    Boolean(r.Certificate_Generated),
    true,
    authScores.Overall_Green_Score,
    r.Child_Name || "",
    r.Student_Class || "",
    r.Roll_Number || "",
    Boolean(r.Guardian_Assisted),
    selectedIdsStr,
    questionOrderStr,
    authScores.Sustainable_Habit_Score,
    authScores.Decision_Making_Score,
    authScores.Environmental_Awareness_Score,
    authScores.Practical_Application_Score,
    authCarbon.Total_Monthly_CO2e_kg,
    authCarbon.Total_Annual_CO2e_kg,
    authCarbon.Calculation_Status,
    r.Device_Type || "",
    r.Browser || "",
    r.Completion_Time_sec || 0,
    r.Source || "web"
  ];

  var respIdx = findRowByResponseId(sheets.respondent, responseId);
  if (respIdx === -1) {
    sheets.respondent.appendRow(respondentRow);
  } else {
    sheets.respondent.getRange(respIdx, 1, 1, respondentRow.length).setValues([respondentRow]);
  }

  // 3. Upsert Kids_Quiz_Responses
  var quizRowData = [responseId];
  for (var i = 0; i < KIDS_ALL_QUESTION_IDS.length; i++) {
    var qId = KIDS_ALL_QUESTION_IDS[i];
    quizRowData.push(answersMap[qId] || "");
  }
  quizRowData.push(
    ageGroup,
    quizMode,
    selectedIdsStr,
    questionOrderStr,
    JSON.stringify(authScores.Records)
  );

  var qIdx = findRowByResponseId(sheets.quiz, responseId);
  if (qIdx === -1) {
    sheets.quiz.appendRow(quizRowData);
  } else {
    sheets.quiz.getRange(qIdx, 1, 1, quizRowData.length).setValues([quizRowData]);
  }

  // 4. Upsert Kids_Footprint_Missions
  var m1 = fm.FP01_School_Commute || fm.FP01 || {};
  var m2 = fm.FP02_Daily_Travel || fm.FP02 || {};
  var m3 = fm.FP03_Household_Electricity || fm.FP03 || {};
  var m4 = fm.FP04_Supplies_Devices || fm.FP04 || {};
  var m5 = fm.FP05_Food_Waste || fm.FP05 || {};

  var missionRowData = [
    responseId,
    new Date(),
    ageGroup,
    quizMode,
    m1.mode || "", m1.fuel || "", m1.oneWayKm || 0, m1.schoolDaysPerWeek || 0, m1.returnTrip || "", m1.occupancy || 1, Boolean(m1.hasSecondLeg),
    m2.journeyType || "", m2.mode || "", m2.fuel || "", m2.distanceKm || 0, m2.tripsPerWeek || 0, m2.occupancy || 1,
    m3.billAvailable || "", Boolean(m3.guardianAssisted), m3.monthlyKwh || 0, m3.householdSize || 4, authCarbon.Allocated_Child_kWh, m3.reportingPeriod || "Typical Month",
    m4.notebooksPerYear || 0, m4.stationerySetsPerYear || 0, m4.uniformSetsPerYear || 0, m4.primaryDevice || "", m4.deviceAge || "", m4.deviceOwnership || "", m4.dailyHours || 0,
    m5.dietCategory || "", m5.mealsPerDay || 3, m5.dairyServingsPerDay || 0, m5.portionSize || "", m5.wasteFrequency || "", m5.wasteGramsPerWeek || 0, m5.wasteDisposal || ""
  ];

  var mIdx = findRowByResponseId(sheets.missions, responseId);
  if (mIdx === -1) {
    sheets.missions.appendRow(missionRowData);
  } else {
    sheets.missions.getRange(mIdx, 1, 1, missionRowData.length).setValues([missionRowData]);
  }

  // 5. Upsert Kids_Carbon_Breakdown
  var carbonRowData = [
    responseId,
    (authScores.Topics["Nature & Biodiversity"] && authScores.Topics["Nature & Biodiversity"].earned) || 0,
    (authScores.Topics["Water Conservation"] && authScores.Topics["Water Conservation"].earned) || 0,
    (authScores.Topics["Energy Conservation"] && authScores.Topics["Energy Conservation"].earned) || 0,
    (authScores.Topics["Waste & Recycling"] && authScores.Topics["Waste & Recycling"].earned) || 0,
    (authScores.Topics["Food Sustainability"] && authScores.Topics["Food Sustainability"].earned) || 0,
    (authScores.Topics["Green Transport"] && authScores.Topics["Green Transport"].earned) || 0,
    (authScores.Topics["Climate Awareness"] && authScores.Topics["Climate Awareness"].earned) || 0,
    authScores.Environmental_Awareness_Score,
    authScores.Strongest_Category,
    authScores.Improvement_Area,
    authScores.Environmental_Awareness_Score,
    authScores.Sustainable_Habit_Score,
    authScores.Decision_Making_Score,
    authScores.Practical_Application_Score,
    authScores.Overall_Green_Score,
    authCarbon.School_Commute_CO2e_kg,
    authCarbon.Daily_Travel_CO2e_kg,
    authCarbon.Allocated_Electricity_CO2e_kg,
    authCarbon.Supplies_Devices_CO2e_kg,
    authCarbon.Food_Waste_CO2e_kg,
    authCarbon.Total_Monthly_CO2e_kg,
    authCarbon.Total_Annual_CO2e_kg,
    authCarbon.Calculation_Status,
    JSON.stringify(c.Emission_Rows || [])
  ];

  var cIdx = findRowByResponseId(sheets.carbon, responseId);
  if (cIdx === -1) {
    sheets.carbon.appendRow(carbonRowData);
  } else {
    sheets.carbon.getRange(cIdx, 1, 1, carbonRowData.length).setValues([carbonRowData]);
  }

  // 6. Upsert Kids_Recommendations
  var recRowData = [
    responseId,
    rec.Recommendation_1 || "",
    rec.Recommendation_2 || "",
    rec.Recommendation_3 || "",
    rec.Priority || "High",
    rec.Suggested_Action || authScores.Improvement_Area,
    100 - authScores.Overall_Green_Score,
    rec.Status || "Active",
    rec.Recommendation_4 || "",
    JSON.stringify(rec.Items || [])
  ];

  var recIdx = findRowByResponseId(sheets.recommendations, responseId);
  if (recIdx === -1) {
    sheets.recommendations.appendRow(recRowData);
  } else {
    sheets.recommendations.getRange(recIdx, 1, 1, recRowData.length).setValues([recRowData]);
  }

  if (logs) {
    logs.appendRow([new Date(), "KIDS FINAL SAVE", "Completed Kids Quiz saved for " + responseId + " (Score: " + authScores.Overall_Green_Score + "/100)"]);
  }
}

function updateKidsDashboard(ss) {
  if (!ss) {
    ss = getSpreadsheet();
  }
  var dashboard = ss.getSheetByName("Kids_Dashboard_Data");
  if (!dashboard) {
    try {
      dashboard = ss.insertSheet("Kids_Dashboard_Data");
      dashboard.appendRow(["Metric", "Value"]);
      var initialMetrics = [
        ["Total Respondents", 0],
        ["Completed Quizzes", 0],
        ["Average Quiz Score (%)", 0],
        ["Average Green Score (Points)", 0],
        ["Top Learning Stage", "N/A"],
        ["Completion Rate (%)", 0]
      ];
      dashboard.getRange(2, 1, initialMetrics.length, 2).setValues(initialMetrics);
    } catch (e) {
      dashboard = null;
    }
  }
  var respondent = ss.getSheetByName("Kids_Respondent_Master");
  if (!dashboard || !respondent || respondent.getLastRow() <= 1) return;

  var data = respondent.getDataRange().getValues();
  var headers = data[0];
  var idxFinal = headers.indexOf("Is_Final");
  var idxScore = headers.indexOf("Overall_Green_Score");
  var idxPct = headers.indexOf("Quiz_Score_Percentage");
  var idxStage = headers.indexOf("Learning_Stage");

  var total = data.length - 1;
  var completed = 0;
  var sumScore = 0;
  var sumPct = 0;
  var stages = {};

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var isFin = row[idxFinal] === true || String(row[idxFinal]).toLowerCase() === "true";
    if (isFin) {
      completed++;
      sumScore += Number(row[idxScore]) || 0;
      sumPct += Number(row[idxPct]) || 0;
      var st = row[idxStage];
      if (st) stages[st] = (stages[st] || 0) + 1;
    }
  }

  var avgScore = completed > 0 ? Math.round(sumScore / completed) : 0;
  var avgPct = completed > 0 ? Math.round(sumPct / completed) : 0;
  var topStage = getTopKey(stages) || "Seedling Explorer";
  var compRate = total > 0 ? Math.round((completed / total) * 100) : 0;

  if (dashboard.getLastRow() >= 11) {
    dashboard.getRange(2, 2, 2, 1).setValues([[total], [completed]]);
    dashboard.getRange(4, 2, 2, 1).setValues([[avgPct], [avgScore]]);
    dashboard.getRange(10, 2, 2, 1).setValues([[topStage], [compRate]]);
  }
}

function doGet(e) {
  var ss = getSpreadsheet();
  var params = (e && e.parameter) || {};
  var action = String(params.action || "").trim();
  var callback = String(params.callback || "").trim();
  var result = { status: "error", message: "Unknown action" };

  try {
    if (action === "getEmissionFactors") {
      ensureKidsSheets(ss);
      var efSheet = ss.getSheetByName("Emission_Factors");
      var efValues = efSheet.getDataRange().getValues();
      var efHeaders = efValues[0];
      var factors = [];
      for (var i = 1; i < efValues.length; i++) {
        var obj = {};
        for (var c = 0; c < efHeaders.length; c++) {
          obj[efHeaders[c]] = efValues[i][c];
        }
        factors.push(obj);
      }
      result = { status: "success", data: factors };
    } else if (action === "getKidsQuestions") {
      var ageGroup = String(params.ageGroup || "8-10").trim();
      var qSheetName = ageGroup === "11-14" ? "YoungAdults_Questions" : "Kids_Questions";
      var qSheet = ss.getSheetByName(qSheetName);
      var safeQuestions = [];
      if (qSheet && qSheet.getLastRow() > 1) {
        var qData = qSheet.getDataRange().getValues();
        var qHeaders = qData[0];
        for (var r = 1; r < qData.length; r++) {
          var qObj = {};
          for (var col = 0; col < qHeaders.length; col++) {
            var h = String(qHeaders[col]);
            // Strip answer keys & option scores before sending to frontend
            if (h === "Correct_Answer" || h.indexOf("_Score") !== -1) continue;
            qObj[h] = qData[r][col];
          }
          safeQuestions.push(qObj);
        }
      }
      result = { status: "success", ageGroup: ageGroup, data: safeQuestions };
    } else if (action === "getKidsResponse" || action === "getResponse") {
      var responseId = String(params.id || "").trim();
      var isKids = action === "getKidsResponse" || responseId.indexOf("MCC-KIDS-") === 0;
      var masterName = isKids ? "Kids_Respondent_Master" : "Respondent_Master";
      var masterSheet = ss.getSheetByName(masterName);
      var rowNum = masterSheet ? findRowByResponseId(masterSheet, responseId) : -1;
      if (rowNum !== -1) {
        var headers = masterSheet.getRange(1, 1, 1, masterSheet.getLastColumn()).getValues()[0];
        var vals = masterSheet.getRange(rowNum, 1, 1, masterSheet.getLastColumn()).getValues()[0];
        var recObj = {};
        for (var k = 0; k < headers.length; k++) recObj[headers[k]] = vals[k];
        result = { status: "success", data: { Respondent_Master: recObj } };
      } else {
        result = { status: "error", message: "Response_ID not found: " + responseId };
      }
    }
  } catch (err) {
    result = { status: "error", message: err.toString() };
  }

  var jsonStr = JSON.stringify(result);
  if (callback) {
    return ContentService
      .createTextOutput(callback + "(" + jsonStr + ");")
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService
    .createTextOutput(jsonStr)
    .setMimeType(ContentService.MimeType.JSON);
}