    r.Consent_Given,
    r.Device_Type,
    r.Browser,
    r.Completion_Time_sec,
    r.Quiz_Completed,
    r.Source
  ];── */


/* ── Respondent_Master: update existing row or create new ── */
  var respondentData = [
    responseId,
    new Date(),
    r.Name,
    r.Email,
    r.City,
    r.State,
    r.Occupation,
    r.Age_Group,
    r.Carbon_Score,
    r.Monthly_CO2_kg,
    r.Annual_CO2_t,
    r.Green_Points,
    
    // --- 6 NEW COLUMNS ADDED HERE ---
    r.Awareness_Score,
    r.Awareness_Breakdown,
    r.Green_Points_Breakdown,
    r.Consistency_Score,
    r.Sustainability_Stage,
    r.Is_Final,
    // --------------------------------
    r.Badge,
    r.Quiz_Version,
    r.Certificate_Generated,
    r.Consent_Given,
    r.Device_Type,
    r.Browser,
    r.Completion_Time_sec,
    r.Quiz_Completed,
    r.Source
